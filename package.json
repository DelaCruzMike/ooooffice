{
  "name": "ooooffice",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server": "node --import tsx server/index.ts",
    "server:watch": "node --import tsx --watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "loadtest": "node --import tsx scripts/loadtest.ts",
    "start": "node --import tsx server/index.ts"
  },
  "dependencies": {
    "@babylonjs/core": "^8.0.0",
    "@colyseus/core": "~0.16.0",
    "@colyseus/ws-transport": "~0.16.0",
    "@dimforge/rapier2d-compat": "^0.21.0",
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@supabase/supabase-js": "^2.0.0",
    "chess.js": "^1.4.0",
    "colyseus.js": "~0.16.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.21.0",
    "livekit-client": "^2.0.0",
    "livekit-server-sdk": "^2.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/cors": "^2.8.0",
    "@types/express": "^4.17.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "~5.7.0",
    "vite": "^6.0.0"
  }
}
